[sub_resource type="Resource" id="Resource_njuw8"]
script = ExtResource("5_plig5")
character = "???"
text = "Cold light flickered overhead.When I opened my eyes, the ceiling above me was a grid of sterile white panels—some cracked, some blinking as if struggling to stay alive. The air smelled metallic, like rust and recycled oxygen."
metadata/_custom_type_script = "uid://bfiaocyt6dkue"

[sub_resource type="Resource" id="Resource_0li75"]
script = ExtResource("5_plig5")
character = "???"
text = "I wasn’t in my room."
metadata/_custom_type_script = "uid://bfiaocyt6dkue"

[sub_resource type="Resource" id="Resource_sxsvc"]
script = ExtResource("5_plig5")
character = "???"
text = "I wasn’t anywhere I recognized. "
metadata/_custom_type_script = "uid://bfiaocyt6dkue"

[sub_resource type="Resource" id="Resource_t3sxm"]
script = ExtResource("5_plig5")
character = "???"
