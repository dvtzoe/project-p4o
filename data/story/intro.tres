[sub_resource type="Resource" id="Resource_v0c48"]
script = ExtResource("5_plig5")
character = "???"
text = "She looked younger. Her clothing didn’t match any fashion I’d ever seen—sleek, form-fitting fabric lined with faint luminous patterns that pulsed like circuitry. Her eyes reflected the overhead lights strangely, as if there were something glass-like beneath the surface."
metadata/_custom_type_script = "uid://bfiaocyt6dkue"

